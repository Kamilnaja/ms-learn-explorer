{
  "name": "ms-learn-explorer",
  "version": "1.0.0",
  "description": "Rozszerzenie do Firefoksa: jeden przycisk \"Dalej\" prowadzący liniowo przez kursy Microsoft Learn.",
  "private": true,
  "scripts": {
    "lint": "web-ext lint --source-dir . --self-hosted",
